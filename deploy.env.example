# URLs publicas (https://) de cada servicio por ngrok, para: .\start-all.ps1 -Mode Tunnel
# Copia este archivo a deploy.env (no se sube a git) y pon las URLs reales de tus tuneles.
# Todas las PCs del grupo usan el MISMO deploy.env.
#
# No pongas aqui secretos ni el authtoken de ngrok: solo URLs.
# El mesh de los auths (/auth-mesh) y de los coordinadores (/mesh) va por el mismo tunel,
# asi que basta UN tunel por servicio (7 en total).

# Auths (puertos locales 4001, 4002, 4003)
AUTH_A_URL=https://auth-a-ejemplo.ngrok-free.dev
AUTH_B_URL=https://auth-b-ejemplo.ngrok-free.dev
AUTH_C_URL=https://auth-c-ejemplo.ngrok-free.dev

# Coordinadores (puertos locales 5001, 5002, 5003)
COORD_1_URL=https://coord-1-ejemplo.ngrok-free.dev
COORD_2_URL=https://coord-2-ejemplo.ngrok-free.dev
COORD_3_URL=https://coord-3-ejemplo.ngrok-free.dev

# Cliente (puerto local 3000). Se usa para permitir su origen (CORS) en auths y coordinadores.
CLIENT_URL=https://cliente-ejemplo.ngrok-free.dev
