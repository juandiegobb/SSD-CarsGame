PORT=3000
# Taller 7: lista de los 3 auths (líder + réplicas), separada por comas.
# El cliente prueba uno, y si falla o es réplica pasa al siguiente / al líder.
AUTH_URLS=http://localhost:4001,http://localhost:4002,http://localhost:4003
# Compatibilidad: si no pones AUTH_URLS se usa AUTH_URL (un solo auth).
# AUTH_URL=http://localhost:4000
# Abriendo http://localhost:3000 el cliente usa LOCAL_AUTH_URLS (por defecto 4001,4002,4003 y 4000);
# AUTH_URLS es para cuando se entra por ngrok.
# LOCAL_AUTH_URLS=http://localhost:4001,http://localhost:4002,http://localhost:4003
COORDINATOR_WS_URL=ws://localhost:5000
# Taller 5: el mismo Client ID que auth-service/.env (es público, no es un secreto)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
