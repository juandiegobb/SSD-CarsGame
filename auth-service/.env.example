# Taller 7: cada auth del grupo replicado tiene su propio ID, puertos y base de datos.
# Con un solo auth se pueden dejar AUTH_ID, PUBLIC_URL, PEER_PORT, PEER_URL y AUTH_PEERS vacíos.
AUTH_ID=auth-a
PORT=4001
PUBLIC_URL=http://localhost:4001
PEER_PORT=4101
PEER_URL=ws://localhost:4101
# Los otros auths del grupo (sin incluirse a sí mismo), separados por coma:
#   authId=URL-del-mesh|URL-pública   (la URL pública después de "|" es opcional)
AUTH_PEERS=auth-b=ws://localhost:4102|http://localhost:4002,auth-c=ws://localhost:4103|http://localhost:4003
# Cuántos cambios puede ir atrasada una réplica y seguir respondiendo /login
READ_LAG_TOLERANCE=10
# Cuánto espera el líder la confirmación de una réplica (opción B)
REPLICATION_ACK_TIMEOUT_MS=2000
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
# Una base distinta por auth (cada uno guarda su propia copia)
DB_PATH=users-auth-a.db
CORS_ORIGINS=http://localhost:3000
COORDINATOR_SHARED_SECRET=replace-with-the-same-random-placeholder-in-auth-and-coordinators
# JWT_SECRET, COORDINATOR_SHARED_SECRET y GOOGLE_CLIENT_ID deben ser IGUALES en todos los auths
# Taller 5: Client ID de Google Cloud (OAuth client ID tipo "Web application")
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
